# ============================================
# NIRIKSHAK AI - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

COMPOSE_PROJECT_NAME=nirikshak-vit

# ---------- LLM API ----------
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

# ---------- Embedding Model ----------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------- PostgreSQL (Supabase) ----------
# Paste your Supabase connection string here. Find it in Database -> Connection String -> URI.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---------- ChromaDB ----------
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---------- MinIO (Object Storage) ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=nirikshak-storage

# ---------- Backend ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
DEBUG=true

# ---------- PaddleOCR ----------
OCR_LANGUAGE=en
OCR_USE_GPU=false

# ---------- File Storage ----------
STORAGE_BACKEND=minio
LOCAL_STORAGE_PATH=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ---------- Celery Worker ----------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
